  "science_invariants": [
    {
      "id": "SCI-NC-01",
      "rule": "노이즈 캔슬링은 특정 위치와 주파수 범위에서 압력 진폭을 줄이는 간섭으로 표현하며 에너지가 사라진다고 하지 않는다."
    },
    {
      "id": "SCI-WAVE-01",
      "rule": "이중 슬릿 중심 간격 d와 단일 슬릿 폭 a를 같은 변수로 취급하지 않는다."
    },
    {
      "id": "SCI-WAVE-02",
      "rule": "1차시 도플러 정량 활동은 정지 매질, 정지 관찰자, 움직이는 음원 조건을 사용하며 매질에 대한 음속은 일정하다."
    },
    {
      "id": "SCI-RADAR-01",
      "rule": "레이더 거리는 왕복 시간 R=cΔt/2, 운동은 도플러 변화와 방사 속도로 구분한다."
    },
    {
      "id": "SCI-ANT-01",
      "rule": "야기 안테나는 주엽 방향의 이득과 감도가 크지만 다른 방향 응답이 0이라고 표현하지 않는다."
    },
    {
      "id": "SCI-LC-01",
      "rule": "이상적 LC 공명은 f0=1/(2π√LC)이며 실제 선택 곡선은 유한 대역폭을 가진다."
    },
    {
      "id": "SCI-EM-01",
      "rule": "전파와 가시광선은 모두 전자기파이며 진공에서 같은 속력 c로 전파한다."
    },
    {
      "id": "SCI-PE-01",
      "rule": "문턱 진동수 아래에서는 세기를 높여도 광전자가 방출되지 않는다."
    },
    {
      "id": "SCI-PE-02",
      "rule": "문턱 위에서 세기는 주로 광전류에, 진동수는 최대 운동 에너지와 정지 전압에 영향을 준다."
    },
    {
      "id": "SCI-DUAL-01",
      "rule": "전자 한 개의 검출은 국소적 점이고 누적 분포가 간섭 또는 회절 무늬를 보이며 전자가 물리적으로 갈라진다고 표현하지 않는다."
    },
    {
      "id": "SCI-UNC-01",
      "rule": "Δx와 Δp는 반복 측정 분포의 표준편차이며 ΔxΔp≥ℏ/2이다."
    },
    {
      "id": "SCI-ATOM-01",
      "rule": "전자구름은 실제 안개나 고전 궤도가 아니라 |ψ|² 위치 확률 밀도의 정성적 표현이다."
    }
  ],
