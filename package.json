{
  "name": "project-echo-web-app",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build": "tsc --noEmit && node scripts/validate-content.mjs && vite build && node scripts/write-version-info.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:content": "node scripts/validate-content.mjs",
    "release:archive": "node scripts/archive-release.mjs",
    "release:check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "firebase": "^10.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0",
    "workbox-core": "^7.1.0",
    "workbox-expiration": "^7.1.0",
    "workbox-precaching": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.160.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript": "^5.5.4",
    "jsdom": "^25.0.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.5"
  }
}
