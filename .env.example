# PROJECT ECHO 환경 변수 예시 파일
# 실제 값은 .env(로컬 전용, git에 올리지 않음)에 넣는다.
# 이 MVP의 핵심 수업 경로는 아래 값이 모두 비어 있어도 완전히 작동한다.

# 하위 경로 배포 시 자산 base 경로. 예: /project-echo/
VITE_BASE_PATH=./

# 콘텐츠 버전은 빌드 시 data/content_contract.json에서 자동으로 읽어온다(여기 적어둘 필요 없음).

# 실시간 교사용 진행판은 기본 비활성이다. 사용자 승인 전에는 true로 바꾸지 않는다.
VITE_ENABLE_REALTIME_TEACHER_BOARD=false

# 아래 Firebase 값은 실시간 진행판을 사용자가 승인했을 때만 채운다.
# 채워지지 않으면 앱은 로컬 저장 모드로만 동작한다. 절대 코드에 직접 값을 넣지 않는다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
